---
import {
  Dumbbell,
  Smartphone,
  Apple,
  HeartPulse,
  PersonStanding,
  Building2,
  ArrowRight,
} from 'lucide-astro';

interface Props {
  title: string;
  tagline: string;
  href: string;
  icon: string;
  learnMore: string;
  featured?: boolean;
}

const { title, tagline, href, icon, learnMore, featured = false } = Astro.props;

const iconComponents: Record<string, any> = {
  dumbbell: Dumbbell,
  smartphone: Smartphone,
  apple: Apple,
  'heart-pulse': HeartPulse,
  'person-standing': PersonStanding,
  'building-2': Building2,
};

const IconComponent = iconComponents[icon] ?? Dumbbell;
---

<a
  href={href}
  class:list={[
    'group flex flex-col gap-5 p-7 rounded-3xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl',
    featured
      ? 'bg-white border-brand-200 shadow-md'
      : 'bg-white border-gray-100 hover:border-brand-200 shadow-sm',
  ]}
>
  <!-- Icon -->
  <div
    class:list={[
      'w-12 h-12 rounded-2xl flex items-center justify-center',
      featured ? 'bg-brand-50' : 'bg-brand-50',
    ]}
  >
    <IconComponent class="w-6 h-6 text-brand-700" />
  </div>

  <!-- Content -->
  <div class="flex-1">
    <h3 class="font-bold text-lg mb-1.5 leading-snug text-gray-900">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-gray-500">
      {tagline}
    </p>
  </div>

  <!-- Arrow link -->
  <span
    class="flex items-center gap-1.5 text-sm font-semibold transition-colors text-brand-600 group-hover:text-brand-700"
  >
    {learnMore}
    <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
  </span>
</a>

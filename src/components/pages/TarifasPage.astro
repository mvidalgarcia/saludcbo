---
import { Check } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import es from '../../i18n/es.json';
import en from '../../i18n/en.json';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const tr = lang === 'es' ? es : en;
const tariffs = tr.services.tarifas;
const cat = tariffs.categories;
---

<BaseLayout lang={lang} title={t('meta.tarifas.title')} description={t('meta.tarifas.description')}>
  {/* Hero */}
  <section class="bg-brand-50 py-24 lg:py-28 border-b border-brand-100">
    <div class="container-main text-center max-w-2xl mx-auto">
      <p class="eyebrow mb-5">{tariffs.hero.eyebrow}</p>
      <h1 class="text-5xl lg:text-6xl font-extrabold text-gray-900 mb-5">
        {tariffs.hero.title}
      </h1>
      <p class="section-subtitle text-xl">{tariffs.hero.subtitle}</p>
    </div>
  </section>

  {/* Entrenamiento Personal */}
  <section class="section-pad bg-white">
    <div class="container-main max-w-4xl mx-auto">
      <div class="mb-10">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-2">{cat.entrenamiento.name}</h2>
        <p class="text-gray-500">{cat.entrenamiento.intro}</p>
      </div>

      {/* Sesión individual */}
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-8 rounded-3xl border-2 border-gray-200 mb-8"
      >
        <div>
          <h3 class="text-xl font-bold text-gray-900">{cat.entrenamiento.singleSession}</h3>
          <p class="text-gray-500 text-sm mt-1">{cat.entrenamiento.singleSessionDesc}</p>
        </div>
        <div class="text-right">
          <span class="text-4xl font-extrabold text-gray-900"
            >{cat.entrenamiento.singleSessionPrice}</span
          >
          <span class="text-gray-500 ml-1 text-sm">{cat.entrenamiento.singleSessionUnit}</span>
        </div>
      </div>

      {/* Grupos */}
      <div class="mb-10">
        <h3 class="text-xl font-bold text-gray-900 mb-1">{cat.entrenamiento.groups.name}</h3>
        <p class="text-gray-500 text-sm mb-6">{cat.entrenamiento.groups.subtitle}</p>

        <div class="bg-white rounded-3xl border border-gray-200 overflow-hidden">
          {/* Header */}
          <div class="grid grid-cols-2 bg-brand-600 text-white text-sm font-bold">
            <div class="px-6 py-4">{cat.entrenamiento.groups.sessions}</div>
            <div class="px-6 py-4 text-right">{cat.entrenamiento.groups.priceLabel}</div>
          </div>

          {/* Rows */}
          {
            cat.entrenamiento.groups.plans.map((plan, i) => (
              <div
                class:list={[
                  'grid grid-cols-2 items-center px-6 py-5',
                  i < cat.entrenamiento.groups.plans.length - 1 ? 'border-b border-gray-100' : '',
                ]}
              >
                <div>
                  <p class="font-semibold text-gray-900">{plan.freq}</p>
                  <p class="text-sm text-gray-500">({plan.count})</p>
                </div>
                <div class="text-right">
                  <span class="text-2xl font-extrabold text-gray-900">{plan.price}</span>
                  <span class="text-gray-500 ml-1 text-sm">{cat.entrenamiento.groups.monthly}</span>
                </div>
              </div>
            ))
          }
        </div>

        {/* Highlights */}
        <div class="grid sm:grid-cols-3 gap-4 mt-6">
          {
            [
              cat.entrenamiento.groups.sessionDuration,
              cat.entrenamiento.groups.ratio,
              cat.entrenamiento.groups.flexible,
            ].map((item) => (
              <div class="flex items-center gap-2 text-sm text-gray-700">
                <Check class="w-5 h-5 text-brand-600 shrink-0" />
                {item}
              </div>
            ))
          }
        </div>
      </div>

      {/* Descuento */}
      <div class="flex items-start gap-4 p-6 rounded-2xl bg-brand-50 border border-brand-100">
        <Check class="w-6 h-6 text-brand-600 shrink-0 mt-0.5" />
        <div>
          <h3 class="font-bold text-gray-900">{cat.entrenamiento.discount.title}</h3>
          <p class="text-sm text-gray-600 mt-1">{cat.entrenamiento.discount.description}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Pilates Reformer */}
  <section class="section-pad bg-brand-50 border-t border-brand-100">
    <div class="container-main max-w-4xl mx-auto">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-8 rounded-3xl border-2 border-dashed border-gray-300"
      >
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-1">{cat.pilates.name}</h2>
          <p class="text-gray-500 text-sm">{cat.pilates.intro}</p>
          <p class="text-gray-400 text-sm mt-2">{cat.pilates.placeholder}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Nutrición */}
  <section class="section-pad bg-white border-t border-gray-100">
    <div class="container-main max-w-4xl mx-auto">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-8 rounded-3xl border-2 border-dashed border-gray-300"
      >
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-1">{cat.nutricion.name}</h2>
          <p class="text-gray-500 text-sm">{cat.nutricion.intro}</p>
          <p class="text-gray-400 text-sm mt-2">{cat.nutricion.placeholder}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Fisioterapia */}
  <section class="section-pad bg-brand-50 border-t border-brand-100">
    <div class="container-main max-w-4xl mx-auto">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-8 rounded-3xl border-2 border-dashed border-gray-300"
      >
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-1">{cat.fisio.name}</h2>
          <p class="text-gray-500 text-sm">{cat.fisio.intro}</p>
          <p class="text-gray-400 text-sm mt-2">{cat.fisio.placeholder}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

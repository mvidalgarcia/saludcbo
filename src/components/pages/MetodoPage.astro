---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const base = lang === 'en' ? '/en' : '';
---

<BaseLayout lang={lang} title={t('meta.metodo.title')} description={t('meta.metodo.description')}>
  <section class="bg-white py-24 lg:py-32 relative overflow-hidden">
    <div class="container-main relative text-center max-w-3xl mx-auto">
      <p class="eyebrow mb-5">{t('metodo.hero.eyebrow')}</p>
      <h1 class="text-5xl lg:text-6xl font-extrabold text-gray-900 mb-6">
        {t('metodo.hero.title')}
      </h1>
      <p class="text-gray-500 text-xl leading-relaxed">{t('metodo.hero.subtitle')}</p>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-main">
      <div class="grid lg:grid-cols-2 gap-14 items-center max-w-5xl mx-auto">
        <div>
          <h2 class="section-title mb-5">{t('metodo.intro.title')}</h2>
          <p class="section-subtitle leading-relaxed">{t('metodo.intro.body')}</p>
        </div>
        <div class="grid grid-cols-3 gap-6 text-center">
          {
            [
              { v: t('metodo.intro.stat1Value'), l: t('metodo.intro.stat1Label') },
              { v: t('metodo.intro.stat2Value'), l: t('metodo.intro.stat2Label') },
              { v: t('metodo.intro.stat3Value'), l: t('metodo.intro.stat3Label') },
            ].map((s) => (
              <div class="bg-brand-50 rounded-2xl p-5">
                <p class="text-2xl font-extrabold text-brand-800 mb-1">{s.v}</p>
                <p class="text-gray-500 text-xs leading-snug">{s.l}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-brand-50">
    <div class="container-main">
      <div class="text-center max-w-xl mx-auto mb-14">
        <p class="eyebrow mb-3">{t('metodo.pillars.eyebrow')}</p>
        <h2 class="section-title">{t('metodo.pillars.title')}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-7 max-w-5xl mx-auto">
        {
          [
            { num: '01', title: t('metodo.pillars.p1Title'), body: t('metodo.pillars.p1Body') },
            { num: '02', title: t('metodo.pillars.p2Title'), body: t('metodo.pillars.p2Body') },
            { num: '03', title: t('metodo.pillars.p3Title'), body: t('metodo.pillars.p3Body') },
            { num: '04', title: t('metodo.pillars.p4Title'), body: t('metodo.pillars.p4Body') },
          ].map((p) => (
            <div class="bg-white rounded-3xl p-8 border border-brand-100 shadow-sm">
              <p class="text-5xl font-extrabold text-brand-100 mb-5 leading-none">{p.num}</p>
              <h3 class="text-xl font-bold text-gray-900 mb-3">{p.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-main max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <p class="eyebrow mb-3">{t('metodo.process.eyebrow')}</p>
        <h2 class="section-title">{t('metodo.process.title')}</h2>
      </div>
      <div class="flex flex-col gap-10">
        {
          [
            { title: t('metodo.process.step1Title'), body: t('metodo.process.step1Body') },
            { title: t('metodo.process.step2Title'), body: t('metodo.process.step2Body') },
            { title: t('metodo.process.step3Title'), body: t('metodo.process.step3Body') },
            { title: t('metodo.process.step4Title'), body: t('metodo.process.step4Body') },
          ].map((step, i) => (
            <div class="flex gap-7 items-start">
              <div class="w-10 h-10 rounded-full bg-brand-50 text-brand-700 flex items-center justify-center font-bold shrink-0 border border-brand-200">
                {i + 1}
              </div>
              <div class="pt-1">
                <h3 class="font-bold text-gray-900 mb-1.5">{step.title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{step.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-white border-t border-gray-100">
    <div class="container-main text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-4">
        {lang === 'es' ? '¿Listo para empezar?' : 'Ready to get started?'}
      </h2>
      <p class="text-gray-500 text-lg mb-8 max-w-xl mx-auto">
        {
          lang === 'es'
            ? 'Solicita tu valoración y descubre cómo el Método CBO puede ayudarte.'
            : 'Request your assessment and discover how the CBO Method can help you.'
        }
      </p>
      <a
        href={`${base}/contacto`}
        class="inline-flex items-center gap-2 bg-brand-600 text-white font-semibold py-3.5 px-8 rounded-full hover:bg-brand-700 transition-colors"
      >
        {t('cta.primary')}
      </a>
    </div>
  </section>
</BaseLayout>

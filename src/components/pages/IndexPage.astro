---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../ServiceCard.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const base = lang === 'en' ? '/en' : '';

const servicesData = await getCollection('services');
const mainServices = servicesData
  .filter(s => s.id !== 'empresa-saludable')
  .sort((a, b) => a.data.order - b.data.order);

const testimonials = [
  { name: 'ALBA Bermudez Fernandez', text: lang === 'es'
    ? 'Gran entrenador, profesional, disciplinado, clases amenas y divertidas. Consigues los resultados esperados. Totalmente recomendable.'
    : 'Great trainer, professional, disciplined, enjoyable and fun classes. You get the expected results. Totally recommended.' },
  { name: 'Jabato', text: lang === 'es'
    ? 'Profesional de los pies a la cabeza. Carlos tiene una formación muy avanzada y está al día con los estudios sobre nutrición y ejercicio. Cambios muy notables en pocos meses.'
    : 'Professional through and through. Carlos has very advanced training and stays up to date with studies on nutrition and exercise. Very noticeable changes in a few months.' },
  { name: 'Ana Saavedra', text: lang === 'es'
    ? 'Carlos es muy buen profesional. Te adapta el ejercicio a tus condiciones físicas. Hemos mejorado muchísimo en 6 meses. Lo hacemos online y resulta muy cómodo. Lo recomiendo sin duda.'
    : 'Carlos is a very good professional. He adapts the exercise to your physical conditions. We improved a lot in 6 months. We do it online and it is very convenient. I definitely recommend it.' },
];
---

<BaseLayout lang={lang} title={t('meta.home.title')} description={t('meta.home.description')}>

  <!-- ═══════════ HERO ═══════════ -->
  <section class="relative bg-brand-950 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-brand-700/20 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-brand-800/30 blur-3xl pointer-events-none"></div>

    <div class="container-main relative py-24 lg:py-36">
      <div class="max-w-3xl">
        <p class="eyebrow-light mb-6">{t('home.hero.eyebrow')}</p>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-white leading-[1.05] mb-8">
          {t('home.hero.heading1')}<br />
          {t('home.hero.heading2')} <span class="text-brand-400">{t('home.hero.headingAccent')}</span>
        </h1>

        <p class="text-lg lg:text-xl text-brand-200 leading-relaxed mb-10 max-w-2xl">
          {t('home.hero.subtitle')}
        </p>

        <div class="flex flex-wrap gap-4">
          <a href={`${base}/contacto`} class="btn-primary text-base py-3.5 px-8">{t('cta.primary')}</a>
          <a href={`${base}/metodo`} class="btn-ghost-dark text-base py-3.5 px-8">{t('cta.secondary')} →</a>
        </div>

        <div class="mt-16 flex flex-wrap gap-10">
          {[
            { value: t('home.hero.stat1Value'), label: t('home.hero.stat1Label') },
            { value: t('home.hero.stat2Value'), label: t('home.hero.stat2Label') },
            { value: t('home.hero.stat3Value'), label: t('home.hero.stat3Label') },
          ].map(stat => (
            <div>
              <p class="text-4xl font-extrabold text-white">{stat.value}</p>
              <p class="text-brand-300 text-sm mt-1">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ SERVICES ═══════════ -->
  <section class="section-pad bg-white">
    <div class="container-main">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="eyebrow mb-3">{t('home.services.eyebrow')}</p>
        <h2 class="section-title mb-4">{t('home.services.title')}</h2>
        <p class="section-subtitle">{t('home.services.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {mainServices.map((svc, i) => {
          const tr = svc.data.translations[lang];
          const svcBase = lang === 'en' ? '/en/services' : '/servicios';
          const href = `${svcBase}/${svc.data.slug[lang]}`;
          return (
            <ServiceCard
              title={tr.title}
              tagline={tr.tagline}
              href={href}
              icon={svc.data.icon}
              learnMore={t('cta.learnMore')}
              featured={i === 0}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════ MÉTODO CBO ═══════════ -->
  <section class="section-pad bg-brand-950 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 28px 28px;"></div>

    <div class="container-main relative">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="eyebrow-light mb-4">{t('home.method.eyebrow')}</p>
          <h2 class="section-title-light mb-6">{t('home.method.title')}</h2>
          <p class="text-brand-200 text-lg leading-relaxed mb-10">{t('home.method.description')}</p>
          <a href={`${base}/metodo`} class="btn-primary">{t('cta.secondary')}</a>
        </div>

        <div class="flex flex-col gap-6">
          {[
            { title: t('home.method.p1Title'), desc: t('home.method.p1Desc'), num: '01' },
            { title: t('home.method.p2Title'), desc: t('home.method.p2Desc'), num: '02' },
            { title: t('home.method.p3Title'), desc: t('home.method.p3Desc'), num: '03' },
          ].map(p => (
            <div class="flex gap-5 p-6 rounded-2xl bg-white/5 border border-white/10">
              <span class="text-brand-600 font-extrabold text-2xl leading-none mt-0.5 shrink-0">{p.num}</span>
              <div>
                <h3 class="text-white font-bold text-base mb-1.5">{p.title}</h3>
                <p class="text-brand-300 text-sm leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ EQUIPO ═══════════ -->
  <section class="section-pad bg-brand-50">
    <div class="container-main">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="grid grid-cols-2 gap-4">
          {[
            { role: lang === 'es' ? 'Entrenador Personal' : 'Personal Trainer', initials: 'CB' },
            { role: lang === 'es' ? 'Fisioterapeuta' : 'Physiotherapist', initials: 'FT' },
            { role: lang === 'es' ? 'Nutricionista' : 'Nutritionist', initials: 'NU' },
            { role: lang === 'es' ? 'Profesora de Pilates' : 'Pilates Instructor', initials: 'PI' },
          ].map(member => (
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-brand-100 text-center">
              <div class="w-16 h-16 rounded-full bg-brand-100 flex items-center justify-center mx-auto mb-3">
                <span class="text-brand-700 font-bold text-lg">{member.initials}</span>
              </div>
              <p class="text-gray-600 text-sm font-medium">{member.role}</p>
            </div>
          ))}
        </div>

        <div>
          <p class="eyebrow mb-4">{t('home.team.eyebrow')}</p>
          <h2 class="section-title mb-5">{t('home.team.title')}</h2>
          <p class="section-subtitle mb-8">{t('home.team.description')}</p>
          <a href={`${base}/equipo`} class="btn-outline">{t('home.team.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ CENTROS ═══════════ -->
  <section class="section-pad bg-white">
    <div class="container-main">
      <div class="text-center max-w-xl mx-auto mb-12">
        <p class="eyebrow mb-3">{t('home.centers.eyebrow')}</p>
        <h2 class="section-title mb-3">{t('home.centers.title')}</h2>
        <p class="section-subtitle">{t('home.centers.subtitle')}</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <div class="bg-brand-950 text-white rounded-3xl p-8">
          <div class="text-brand-400 font-semibold text-sm uppercase tracking-widest mb-4">Centro 1</div>
          <h3 class="text-xl font-bold mb-2">CBO Health Training Center</h3>
          <p class="text-brand-300 text-sm mb-5">
            P. El Castro, nave 2<br />Lugones, Asturias<br />
            {lang === 'es' ? 'Detrás de Tartiere Auto' : 'Behind Tartiere Auto'}
          </p>
          <p class="text-brand-400 text-xs mb-1">🟢 {lang === 'es' ? 'Aparcamiento gratuito' : 'Free parking'}</p>
          <p class="text-brand-400 text-xs mb-6">📋 {lang === 'es' ? 'Cita previa necesaria' : 'Appointment required'}</p>
          <div class="flex flex-col gap-2">
            <a href="tel:+34667828851" class="flex items-center gap-2 text-brand-300 hover:text-white text-sm transition-colors">📞 +34 667 828 851</a>
            <a href="https://maps.google.com/?q=P.+El+Castro+nave+2+Lugones+Asturias" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-brand-300 hover:text-white text-sm transition-colors">
              📍 {lang === 'es' ? 'Ver en Google Maps' : 'View on Google Maps'}
            </a>
          </div>
        </div>

        <div class="bg-gray-50 border border-gray-100 rounded-3xl p-8">
          <div class="text-brand-600 font-semibold text-sm uppercase tracking-widest mb-4">Centro 2</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">CBO Pilates & {lang === 'es' ? 'Fisioterapia' : 'Physiotherapy'}</h3>
          <p class="text-gray-500 text-sm mb-5">
            Lugones, Asturias<br />
            <span class="text-brand-600 font-medium">{lang === 'es' ? 'Próximamente — detalles por confirmar' : 'Coming soon — details to be confirmed'}</span>
          </p>
          <p class="text-gray-500 text-xs mb-6">🟢 {lang === 'es' ? 'Aparcamiento gratuito' : 'Free parking'}</p>
          <a href={`${base}/centros`} class="btn-outline text-sm py-2.5">{t('home.centers.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ REVIEWS ═══════════ -->
  <section class="section-pad bg-gray-50">
    <div class="container-main">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">{t('home.reviews.eyebrow')}</p>
        <h2 class="section-title mb-4">{t('home.reviews.title')}</h2>
        <div class="flex items-center justify-center gap-3 mb-1">
          <span class="text-2xl font-extrabold text-gray-900">{t('home.reviews.badge')}</span>
          <span class="flex">
            {'★★★★★'.split('').map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </span>
        </div>
        <p class="text-gray-400 text-sm">{t('home.reviews.reviewCount')}</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
        {testimonials.map(review => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex mb-3">
              {'★★★★★'.split('').map(() => (
                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-gray-700 text-sm leading-relaxed mb-4">"{review.text}"</p>
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 font-bold text-xs">
                {review.name.charAt(0)}
              </div>
              <p class="text-gray-500 text-xs font-medium">{review.name}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ INSTAGRAM ═══════════ -->
  <section class="section-pad bg-white">
    <div class="container-main text-center">
      <p class="eyebrow mb-3">{t('home.instagram.eyebrow')}</p>
      <h2 class="section-title mb-3">{t('home.instagram.title')}</h2>
      <p class="section-subtitle mb-8">{t('home.instagram.subtitle')}</p>
      <a href="https://www.instagram.com/cbo.salud" target="_blank" rel="noopener noreferrer" class="btn-outline inline-flex items-center gap-2">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        {lang === 'es' ? 'Seguir en Instagram' : 'Follow on Instagram'}
      </a>
    </div>
  </section>

  <!-- ═══════════ LEAD MAGNET ═══════════ -->
  <section class="section-pad bg-brand-800">
    <div class="container-main">
      <div class="max-w-2xl mx-auto text-center">
        <p class="eyebrow-light mb-4">{t('home.leadMagnet.eyebrow')}</p>
        <h2 class="section-title-light mb-5">{t('home.leadMagnet.title')}</h2>
        <p class="text-brand-200 text-lg leading-relaxed mb-8">{t('home.leadMagnet.description')}</p>
        <a href={`${base}/contacto`} class="btn-primary text-base py-3.5 px-8">📄 {t('home.leadMagnet.cta')}</a>
      </div>
    </div>
  </section>

  <!-- ═══════════ FINAL CTA ═══════════ -->
  <section class="section-pad bg-brand-600">
    <div class="container-main text-center">
      <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4">{t('home.finalCta.title')}</h2>
      <p class="text-brand-100 text-lg mb-10 max-w-xl mx-auto">{t('home.finalCta.subtitle')}</p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:+34667828851" class="flex items-center gap-2 bg-white text-brand-700 font-semibold py-3 px-7 rounded-full hover:bg-brand-50 transition-colors">
          📞 {t('home.finalCta.ctaPhone')}
        </a>
        <a href="https://wa.me/34667828851" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#25D366] text-white font-semibold py-3 px-7 rounded-full hover:bg-[#128C7E] transition-colors">
          💬 {t('home.finalCta.ctaWhatsapp')}
        </a>
        <a href={`${base}/contacto`} class="flex items-center gap-2 border-2 border-white text-white font-semibold py-3 px-7 rounded-full hover:bg-white/10 transition-colors">
          {t('home.finalCta.ctaContact')}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

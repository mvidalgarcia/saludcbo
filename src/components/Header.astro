---
import { Dumbbell, Salad, Handshake, PersonStanding, Globe } from 'lucide-astro';
import { useTranslations, getAlternatePath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const alternateLang: Lang = lang === 'es' ? 'en' : 'es';
const alternatePath = getAlternatePath(Astro.url, alternateLang);

const currentPath = Astro.url.pathname;
const base = lang === 'en' ? '/en' : '';

const svcBase = lang === 'en' ? '/en/services' : '/servicios';
const svcSlug = (es: string, en: string) => (lang === 'en' ? en : es);

const tarifasBase = lang === 'en' ? '/en/pricing' : '/tarifas';
const tarifasSlug = (es: string, en: string) => (lang === 'en' ? en : es);

const navLinks = [
  { href: `${base}/metodo`, label: t('nav.method') },
  { href: `${base}/equipo`, label: t('nav.team') },
  { href: `${base}/centros`, label: t('nav.centers') },
  { href: `${base}/contacto`, label: t('nav.contact') },
];

const services = [
  {
    href: `${svcBase}/${svcSlug('entrenamiento', 'training')}`,
    label: t('nav.training'),
    icon: Dumbbell,
  },
  {
    href: `${svcBase}/${svcSlug('fisioterapia', 'physiotherapy')}`,
    label: t('nav.physio'),
    icon: Handshake,
  },
  {
    href: `${svcBase}/${svcSlug('nutricion', 'nutrition')}`,
    label: t('nav.nutrition'),
    icon: Salad,
  },
  { href: `${svcBase}/pilates`, label: t('nav.pilates'), icon: PersonStanding },
];

const tarifasLinks = [
  { href: `${tarifasBase}/${tarifasSlug('entrenamiento', 'training')}`, label: t('nav.training') },
  {
    href: `${tarifasBase}/${tarifasSlug('fisioterapia', 'physiotherapy')}`,
    label: t('nav.physio'),
  },
  { href: `${tarifasBase}/${tarifasSlug('nutricion', 'nutrition')}`, label: t('nav.nutrition') },
  { href: `${tarifasBase}/${tarifasSlug('pilates', 'pilates')}`, label: t('nav.pilates') },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 bg-white border-b border-gray-100 transition-shadow duration-300"
>
  <div class="container-main">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a
        href={base || '/'}
        class="flex items-center gap-2 shrink-0"
        aria-label="Salud CBO — Inicio"
      >
        <img src="/logo.svg" alt="Salud CBO" class="h-10 w-auto" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        <!-- Servicios dropdown -->
        <div class="relative group">
          <button
            class="flex items-center gap-1 text-gray-700 hover:text-brand-700 font-medium text-sm px-3 py-2 rounded-lg hover:bg-brand-50 transition-colors"
            aria-expanded="false"
            aria-haspopup="true"
          >
            {t('nav.services')}
            <svg
              class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown panel -->
          <div
            class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto"
          >
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden w-64">
              {
                services.map((svc) => {
                  const Icon = svc.icon;
                  return (
                    <a
                      href={svc.href}
                      class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition-colors"
                    >
                      <Icon class="w-5 h-5 text-brand-600 shrink-0" />
                      <span class="font-medium">{svc.label}</span>
                    </a>
                  );
                })
              }
            </div>
          </div>
        </div>

        <!-- Método -->
        <a
          href={`${base}/metodo`}
          class:list={[
            'font-medium text-sm px-3 py-2 rounded-lg transition-colors',
            isActive(`${base}/metodo`)
              ? 'text-brand-700 bg-brand-50'
              : 'text-gray-700 hover:text-brand-700 hover:bg-brand-50',
          ]}
          aria-current={isActive(`${base}/metodo`) ? 'page' : undefined}
        >
          {t('nav.method')}
        </a>

        <!-- Equipo -->
        <a
          href={`${base}/equipo`}
          class:list={[
            'font-medium text-sm px-3 py-2 rounded-lg transition-colors',
            isActive(`${base}/equipo`)
              ? 'text-brand-700 bg-brand-50'
              : 'text-gray-700 hover:text-brand-700 hover:bg-brand-50',
          ]}
          aria-current={isActive(`${base}/equipo`) ? 'page' : undefined}
        >
          {t('nav.team')}
        </a>

        <!-- Centros -->
        <a
          href={`${base}/centros`}
          class:list={[
            'font-medium text-sm px-3 py-2 rounded-lg transition-colors',
            isActive(`${base}/centros`)
              ? 'text-brand-700 bg-brand-50'
              : 'text-gray-700 hover:text-brand-700 hover:bg-brand-50',
          ]}
          aria-current={isActive(`${base}/centros`) ? 'page' : undefined}
        >
          {t('nav.centers')}
        </a>

        <!-- Tarifas dropdown -->
        <div class="relative group">
          <button
            class="flex items-center gap-1 text-gray-700 hover:text-brand-700 font-medium text-sm px-3 py-2 rounded-lg hover:bg-brand-50 transition-colors"
            aria-expanded="false"
            aria-haspopup="true"
          >
            {t('nav.pricing')}
            <svg
              class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown panel -->
          <div
            class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto"
          >
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden w-64">
              {
                tarifasLinks.map((link) => (
                  <a
                    href={link.href}
                    class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition-colors"
                  >
                    <span class="font-medium">{link.label}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Contacto -->
        <a
          href={`${base}/contacto`}
          class:list={[
            'font-medium text-sm px-3 py-2 rounded-lg transition-colors',
            isActive(`${base}/contacto`)
              ? 'text-brand-700 bg-brand-50'
              : 'text-gray-700 hover:text-brand-700 hover:bg-brand-50',
          ]}
          aria-current={isActive(`${base}/contacto`) ? 'page' : undefined}
        >
          {t('nav.contact')}
        </a>
      </nav>

      <!-- Right side: lang switch + CTA + hamburger -->
      <div class="flex items-center gap-3">
        <!-- Language switcher -->
        <a
          href={alternatePath}
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 hover:text-brand-700 px-2.5 py-1.5 rounded-full border border-gray-200 hover:border-brand-300 transition-colors"
          aria-label={`Switch to ${alternateLang === 'en' ? 'English' : 'Spanish'}`}
        >
          <Globe class="w-3.5 h-3.5" />
          <span>{alternateLang.toUpperCase()}</span>
        </a>

        <!-- CTA -->
        <a href={`${base}/contacto`} class="hidden sm:inline-flex btn-primary text-sm py-2 px-5">
          {t('nav.cta')}
        </a>

        <!-- Mobile hamburger -->
        <button
          id="menu-toggle"
          class="lg:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="icon-close"
            class="w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-gray-100 bg-white"
    aria-hidden="true"
  >
    <nav class="container-main py-4 flex flex-col gap-1" aria-label="Menú móvil">
      <!-- Services (flat list on mobile) -->
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest px-3 pt-2 pb-1">
        {lang === 'es' ? 'Servicios' : 'Services'}
      </p>
      {
        services.map((svc) => {
          const Icon = svc.icon;
          return (
            <a
              href={svc.href}
              class:list={[
                'flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors',
                isActive(svc.href)
                  ? 'text-brand-700 bg-brand-50'
                  : 'text-gray-700 hover:bg-brand-50 hover:text-brand-700',
              ]}
              aria-current={isActive(svc.href) ? 'page' : undefined}
            >
              <Icon class="w-5 h-5 text-brand-600 shrink-0" />
              <span>{svc.label}</span>
            </a>
          );
        })
      }

      <hr class="my-2 border-gray-100" />

      <!-- Tarifas (mobile) -->
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest px-3 pt-2 pb-1">
        {lang === 'es' ? 'Tarifas' : 'Pricing'}
      </p>
      {
        tarifasLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors',
              isActive(link.href)
                ? 'text-brand-700 bg-brand-50'
                : 'text-gray-700 hover:bg-brand-50 hover:text-brand-700',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="w-5 h-5 flex items-center justify-center text-brand-600 text-xs font-bold">
              €
            </span>
            <span>{link.label}</span>
          </a>
        ))
      }

      <hr class="my-2 border-gray-100" />

      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2.5 text-sm font-medium rounded-xl transition-colors',
              isActive(link.href)
                ? 'text-brand-700 bg-brand-50'
                : 'text-gray-700 hover:bg-brand-50 hover:text-brand-700',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <hr class="my-2 border-gray-100" />

      <div class="px-3 py-2 flex flex-col gap-3">
        <a
          href={alternatePath}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-brand-700 transition-colors"
        >
          <Globe class="w-4 h-4" />
          {alternateLang.toUpperCase()}
        </a>
        <a href={`${base}/contacto`} class="w-full justify-center btn-primary text-sm py-3">
          {t('nav.cta')}
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer so content isn't hidden under fixed header -->
<div class="h-16 lg:h-20" aria-hidden="true"></div>

<script is:inline>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isOpen);
    menu?.setAttribute('aria-hidden', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen ?? false);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>

---
import ServicePage from '../../../components/ServicePage.astro';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const services = await getCollection('services');
const svc = services.find((s) => s.id === 'entrenamiento-online')!;
const tr = svc.data.translations[lang];
---

<ServicePage
  lang={lang}
  serviceId="entrenamiento-online"
  metaTitle={t('meta.entrenamiento-online.title')}
  metaDescription={t('meta.entrenamiento-online.description')}
  heroEyebrow={t('services.entrenamiento-online.hero.eyebrow')}
  heroTitle={t('services.entrenamiento-online.hero.title')}
  heroSubtitle={t('services.entrenamiento-online.hero.subtitle')}
  description={tr.description}
  tagline={tr.tagline}
  features={tr.features}
  process={tr.process}
  heroImage="/images/online-training.jpg"
/>

---
// Blog stub — hidden from nav until launched
// Remove `draft: true` entries and add to sitemap when ready to launch
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
const base = lang === 'en' ? '/en' : '';
---

<BaseLayout lang={lang} title={t('blog.title')} description={t('blog.description')} noIndex={true}>
  <section class="section-pad bg-white text-center">
    <div class="container-main max-w-xl mx-auto">
      <h1 class="section-title mb-4">{t('blog.comingSoon')}</h1>
      <p class="section-subtitle">{t('blog.body')}</p>
      <a href={base || '/'} class="btn-outline mt-8 inline-flex">{t('blog.backHome')}</a>
    </div>
  </section>
</BaseLayout>

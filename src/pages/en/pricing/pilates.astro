---
import TarifasServicePage from '../../../components/pages/TarifasServicePage.astro';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/utils';

const lang = (Astro.currentLocale ?? 'es') as Lang;
const t = useTranslations(lang);
---

<TarifasServicePage
  service="pilates"
  title={t('meta.tarifas.title')}
  description={t('meta.tarifas.description')}
  eyebrow={t('nav.pilates')}
  heroTitle={t('services.pilates.title')}
  heroSubtitle={t('services.pilates.hero.subtitle')}
/>

# Legacy WordPress URLs -> current Astro URLs.
#
# Production has been WordPress with flat paths (/entrenamiento/), while this
# build nests services under /servicios/. Every indexed legacy URL is listed
# here so existing rankings, backlinks and printed links survive the cutover.
#
# Sources are listed twice, with and without the trailing slash: Cloudflare
# matches `source` literally, and the slash-less form would otherwise 404.
# Destinations keep the trailing slash to avoid a second hop.
#
# Keep in sync with the `redirects` block in astro.config.mjs, which mirrors
# these rules for `astro dev` and `astro preview`.

# --- Spanish -------------------------------------------------------------

/entrenamiento                  /servicios/entrenamiento/   301
/entrenamiento/                 /servicios/entrenamiento/   301
/entrenamiento-personal         /servicios/entrenamiento/   301
/entrenamiento-personal/        /servicios/entrenamiento/   301
/entrenamiento-gruposreducidos  /servicios/entrenamiento/   301
/entrenamiento-gruposreducidos/ /servicios/entrenamiento/   301
/entrenamento-online            /servicios/entrenamiento/   301
/entrenamento-online/           /servicios/entrenamiento/   301

/fisioterapia                   /servicios/fisioterapia/    301
/fisioterapia/                  /servicios/fisioterapia/    301

/nutricion                      /servicios/nutricion/       301
/nutricion/                     /servicios/nutricion/       301

/nosotros                       /equipo/                    301
/nosotros/                      /equipo/                    301

/empresa-saludable              /                           301
/empresa-saludable/             /                           301

# The hand-maintained HTML sitemap is gone; sitemap-index.xml is generated at
# build time. Send visitors looking for the old page to the homepage.
/mapa-del-sitio                 /                           301
/mapa-del-sitio/                /                           301

